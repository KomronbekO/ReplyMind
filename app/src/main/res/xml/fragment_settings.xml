<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".fragment.SettingsFragment">

    <!-- Account/Login section -->
    <Preference
        android:key="@string/pref_account"
        android:title="@string/account"
        android:icon="@drawable/ic_baseline_person_24" />

    <PreferenceCategory android:title="@string/preference_category_general_label">

        <ListPreference android:title="@string/app_language"
            app:icon="@drawable/ic_language"
            android:key="@string/key_pref_app_language"
            android:entries="@array/app_language"
            android:entryValues="@array/app_language_value"
            app:useSimpleSummaryProvider="true"/>

        <CheckBoxPreference android:title="@string/add_attribution_label"
            android:key="@string/pref_is_append_watomatic_attribution"
            android:summary="@string/append_watomatic_arribution_checkbox_label"/>

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/preference_category_notifications_label"
        android:icon="@drawable/ic_notification"
        >

        <SwitchPreference android:title="@string/show_notification_label"
            android:key="@string/pref_show_notification_replied_msg"
            />

        <SwitchPreference android:title="@string/always_on_notification"
            android:key="@string/pref_show_foreground_service_notification"
            android:summary="@string/display_persistent_notification_summary"
            />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/preference_category_troubleshooting_label">

        <Preference android:title="@string/enable_auto_start_label"
            android:key="@string/pref_auto_start_permission" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/preference_category_replymind_label">

        <SwitchPreference
            android:key="@string/pref_classification_enabled"
            android:title="@string/enable_smart_classification_title"
            android:summary="@string/enable_smart_classification_summary" />

        <Preference
            android:key="@string/pref_replymind_profile"
            android:title="@string/edit_your_profile_title"
            android:summary="@string/edit_your_profile_summary" />

        <Preference
            android:key="@string/pref_manage_categories"
            android:title="@string/manage_categories_title"
            android:summary="@string/manage_categories_summary" />

        <Preference
            android:key="@string/pref_vip_contacts"
            android:title="@string/vip_contacts_title"
            android:summary="@string/vip_contacts_summary" />

        <Preference
            android:key="@string/pref_insights"
            android:title="@string/insights_title"
            android:summary="@string/insights_summary" />

        <Preference
            android:key="@string/pref_onboarding_reset"
            android:title="@string/onboarding_reset_title"
            android:summary="@string/onboarding_reset_summary" />

    </PreferenceCategory>

</PreferenceScreen>