<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow cleartext HTTP only for the local development backend. Everything else
  must use HTTPS. Two reachable cases:

    * Android emulator:    http://10.0.2.2:8000   (the emulator-to-host alias)
    * Physical device:     http://127.0.0.1:8000  via `adb reverse tcp:8000 tcp:8000`
                           (the laptop forwards the port over USB; no LAN required)

  Direct LAN URLs are NOT allowed by default — they would broaden the cleartext
  attack surface beyond development. To use one in a demo, add the specific IP
  to this allowlist in a debug-only override.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
