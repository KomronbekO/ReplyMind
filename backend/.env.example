DEMO_TOKEN=change-me-to-something-long-and-random
# Default URL baked into the Android app at build time. Use 10.0.2.2 for
# emulator, 127.0.0.1 for a physical device behind `adb reverse`.
BACKEND_URL=http://127.0.0.1:8765
DATABASE_URL=sqlite:///./data/app.db
CHROMA_DIR=./data/chroma
MODEL_PATH=./models/classifier.pt
LABEL_MAP_PATH=./models/label_map.json
EMBEDDER_NAME=sentence-transformers/all-MiniLM-L6-v2
RAG_K_SENDER=3
RAG_K_GLOBAL=2
RAG_WEIGHT_CURRENT=0.6
RAG_WEIGHT_SENDER=0.3
RAG_WEIGHT_GLOBAL=0.1
